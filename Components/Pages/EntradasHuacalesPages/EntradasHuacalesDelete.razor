@page "/EntradasHuacales/Delete/{EntradaId:int}";

@inject EntradasHuacalesService entradasHuacalesService;
@inject TiposHuacalesServices tiposHuacalesServices;
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Delete</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        @*header*@
        <div class="card-header text-center">
            <h5><strong>Datos de la Entrada de huacales</strong></h5>
        </div>
        @*body*@
        <div class="card-body">
            <div class="text-center">
                <h5><strong>Desea eliminar la entrada?</strong></h5>
            </div>
            <ul class="mt-4">
                <li><strong>EntradaId: </strong>@EntradaHuacales.EntradaId</li>
                <li><strong>Fecha: </strong>@EntradaHuacales.Fecha</li>
                <li><strong>Nombre del cliente: </strong>@EntradaHuacales.NombreCliente</li>
                <li><strong>Monto: </strong>@EntradaHuacales.Precio.ToString("N2")</li>
            </ul>
            <div class="border border-success p-2 mt-2 rounded-3">
                <h7><strong>Detalles de cobro</strong></h7>
                <div class="table-responsive">
                    <QuickGrid class="table table-striped table-hover" Items="@EntradaHuacales.DetallesEntradas.AsQueryable()">
                        <TemplateColumn Title="Tipo de huacales" Context="detalle">
                            @TiposHuacales.Find(t => t.TipoId == detalle.TipoId).Descripcion
                        </TemplateColumn>
                        <PropertyColumn Property="@(d => d.Cantidad)" Sortable="true" Title="Cantidad"></PropertyColumn>
                        <PropertyColumn Property="@(d => d.Precio)" Sortable="true" Title="Precio" Format="N2"></PropertyColumn>
                    </QuickGrid>
                </div>
            </div>
        </div>
        @*Footer*@
        <div class="card-footer text-center">
            <a href="/EntradasHuacales/Edit/@EntradaId" class="btn btn-primary"> <span class="bi bi-arrow-left"></span> Volver</a>
            <button type="button" class="btn btn-danger bi bi-trash" @onclick="Eliminar"> Eliminar</button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int EntradaId { get; set; }

    public EntradasHuacales EntradaHuacales { get; set; } = new EntradasHuacales();
    public List<TiposHuacales> TiposHuacales { get; set; } = new List<TiposHuacales>();

    protected override async Task OnInitializedAsync()
    {
        EntradaHuacales = await entradasHuacalesService.Buscar(EntradaId);
        TiposHuacales = await tiposHuacalesServices.Listar();
    }

    public async Task Eliminar()
    {
        bool eliminado = await entradasHuacalesService.Eliminar(EntradaHuacales.EntradaId);

        if (eliminado)
        {
            toastService.ShowSuccess("Entrada de huacales eliminado exitosamente");
            navigationManager.NavigateTo("/EntradasHuacales/Index");
        }
        else
        {
            toastService.ShowError("Ha ocurrido un error inesperado, vuelva a intentarlo mas tarde");
        }
    }
}