@page "/EntradasHuacales/Edit/{EntradaId:int}";

@inject NavigationManager navigationManager;
@inject EntradasHuacalesService entradasHuacalesService;
@inject TiposHuacalesServices tiposHuacalesServices;
@inject ToastService toastService;

<PageTitle>ModificarEntradasHuacales</PageTitle>
<EditForm Model="EntradaHuacal" FormName="modificarEntradaHuacal" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h3>Modificar entrada de huacales</h3>
            </div>
            <div class="card-body">
                @* Fecha *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <input class="form-control" type="datetime-local" @bind="EntradaHuacal.Fecha" />
                    <ValidationMessage For="(() => EntradaHuacal.Fecha)"></ValidationMessage>
                </div>

                @* Nombre del cliente *@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombre del cliente</strong></label>
                    <InputText class="form-control" @bind-Value="EntradaHuacal.NombreCliente" placeholder="Escriba el nombre del cliente..."></InputText>
                    <ValidationMessage For="(() => EntradaHuacal.NombreCliente)"></ValidationMessage>
                </div>

                <div class="border border-success p-3 rounded-3">
                    <h3>Detalle</h3>

                    @* Titulos *@
                    <div class="row">
                        <div class="col-3">
                            <label class="form-label"><strong>Tipo huacal</strong></label>
                        </div>
                        <div class="col-3">
                            <label class="form-label"><strong>Cantidad</strong></label>
                        </div>
                        <div class="col-3">
                            <label class="form-label"><strong>Precio</strong></label>
                        </div>
                    </div>

                    @* Inputs y botones *@
                    <div class="row mb-3">
                        <div class="col-3">
                            <InputSelect class="form-select" @bind-Value="DetalleEntrada.TipoId">
                                <option value="0" disabled selected hidden>Elija un tipo de huacal...</option>
                                @foreach (TiposHuacales tipoHuacal in TiposHuacales)
                                {
                                    <option value="@tipoHuacal.TipoId">@tipoHuacal.Descripcion</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-3">
                            <input class="form-control" type="number" @bind-value="DetalleEntrada.Cantidad"></input>
                        </div>
                        <div class="col-3">
                            <input class="form-control" type="number" @bind-value="DetalleEntrada.Precio"></input>
                        </div>
                        <div class="col-3">
                            <button class="btn btn-primary" type="button" @onclick="CrearDetalle"><span class="bi bi-plus"></span> Agregar</button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <QuickGrid class="table table-striped table-hover" Items="@EntradaHuacal.DetallesEntradas.AsQueryable()">
                            <TemplateColumn Title="Tipo de huacales" Context="detalle">
                                @TiposHuacales.Find(t => t.TipoId == detalle.TipoId).Descripcion
                            </TemplateColumn>
                            <PropertyColumn Property="@(d => d.Cantidad)" Sortable="true" Title="Cantidad"></PropertyColumn>
                            <PropertyColumn Property="@(d => d.Precio)" Sortable="true" Title="Precio"></PropertyColumn>
                            <TemplateColumn Class="text-center" Align="Align.Center" Title="Acciones" Context="detalle">
                                <button class="btn btn-outline-danger bi bi-trash" type="button" @onclick="() => EliminarDetalle(detalle)"></button>
                            </TemplateColumn>
                        </QuickGrid>
                    </div>

                    <div class="row">
                        @* Cantiadad *@
                        <div class="col-3 offset-4">
                            <div class="mb-3">
                                <label class="form-label"><strong>Cantidad total</strong></label>
                                <input class="form-control" @bind-value="EntradaHuacal.Cantidad" disabled></input>
                                <ValidationMessage For="(() => EntradaHuacal.Cantidad)"></ValidationMessage>
                            </div>
                        </div>

                        @* Monto *@
                        <div class="col-5">
                            <div class="mb-3">
                                <label class="form-label"><strong>Monto</strong></label>
                                <input class="form-control" @bind-value="EntradaHuacal.Precio" disabled></input>
                                <ValidationMessage For="(() => EntradaHuacal.Precio)"></ValidationMessage>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer text-center">
                <a class="btn btn-secondary" href="/EntradasHuacales/Index"><span class="bi bi-arrow-left"></span> Volver</a>
                <button class="btn btn-primary" type="submit"><span class="bi bi-floppy"></span> Guardar</button>
                <a class="btn btn-danger" href="/EntradasHuacales/Delete/@EntradaHuacal.EntradaId"><span class="bi bi-trash"></span> Eliminar</a>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public EntradasHuacales EntradaHuacal { get; set; } = new EntradasHuacales();
    public DetallesEntradas DetalleEntrada { get; set; } = new DetallesEntradas();
    public List<TiposHuacales> TiposHuacales { get; set; } = new List<TiposHuacales>();
    public int Cantidad { get; set; } = 0;
    public decimal Precio { get; set; } = 0;

    [Parameter]
    public int EntradaId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        EntradaHuacal = await entradasHuacalesService.Buscar(EntradaId);
        TiposHuacales = await tiposHuacalesServices.Listar();
    }

    public async Task Modificar()
    {
        if (EntradaHuacal.DetallesEntradas.Count == 0)
        {
            toastService.ShowWarning("Debe agregar al menos un detalle");
            return;
        }

        bool modificado = await entradasHuacalesService.Guardar(EntradaHuacal);
        if (modificado)
        {
            toastService.ShowSuccess("Entrada de huacales modificado exitosamente");
            navigationManager.NavigateTo("/EntradasHuacales/Index");
        }
        else
        {
            toastService.ShowError("Ha ocurrido un error inesperado, vuelva a intentarlo mas tarde");
        }
    }

    public async Task Eliminar()
    {
        bool eliminado = await entradasHuacalesService.Eliminar(EntradaHuacal.EntradaId);

        if (eliminado)
        {
            toastService.ShowSuccess("Entrada de huacales eliminado exitosamente");
            navigationManager.NavigateTo("/EntradasHuacales/Index");
        }
        else
        {
            toastService.ShowError("Ha ocurrido un error inesperado, vuelva a intentarlo mas tarde");
        }
    }

    public async Task CrearDetalle()
    {
        if (DetalleEntrada.TipoId <= 0)
        {
            toastService.ShowWarning("Debes elegir un tipo de huacal");
            return;
        }
        if (DetalleEntrada.Cantidad <= 0)
        {
            toastService.ShowWarning("La cantidad de huacales deben ser mayor que 0");
            return;
        }
        if (DetalleEntrada.Precio <= 0)
        {
            toastService.ShowWarning("El precio de los huacales deben ser mayor que 0");
            return;
        }

        DetalleEntrada.EntradaId = EntradaHuacal.EntradaId;
        EntradaHuacal.Precio += DetalleEntrada.Precio * DetalleEntrada.Cantidad;
        EntradaHuacal.DetallesEntradas.Add(DetalleEntrada);
        DetalleEntrada = new DetallesEntradas();
        await Task.CompletedTask; // Investigar despues
    }

    public async Task EliminarDetalle(DetallesEntradas DetalleEliminado)
    {
        DetalleEntrada.Cantidad = DetalleEliminado.Cantidad;
        DetalleEntrada.Precio = DetalleEliminado.Precio;
        DetalleEntrada.TipoId = DetalleEliminado.TipoId;
        EntradaHuacal.Precio -= DetalleEliminado.Precio * DetalleEliminado.Cantidad;
        EntradaHuacal.DetallesEntradas.Remove(DetalleEliminado);
        await Task.CompletedTask; // Investigar despues
    }
}